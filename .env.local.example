# Sanity CMS — copy this file to .env.local and fill in the values

# Public (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# Server-only (never expose in the browser)
SANITY_API_READ_TOKEN=your_read_token_here

# Anthropic chatbot — get your key at https://console.anthropic.com/settings/keys
# NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only
ANTHROPIC_API_KEY=your_anthropic_api_key_here
